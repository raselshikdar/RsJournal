{
  "entities": {
    "Post": {
      "title": "Post",
      "description": "Blog article published or drafted by author",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "slug": { "type": "string", "maxLength": 200 },
        "excerpt": { "type": "string", "maxLength": 500 },
        "content": { "type": "string", "maxLength": 50000 },
        "coverImage": { "type": "string", "maxLength": 1000 },
        "category": { "type": "string", "maxLength": 60 },
        "tags": {
          "type": "array",
          "description": "List of tags associated with the post"
        },
        "authorId": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 100 },
        "authorEmail": { "type": "string", "maxLength": 150 },
        "authorAvatar": { "type": "string", "maxLength": 1000 },
        "readingTimeMinutes": { "type": "number" },
        "viewsCount": { "type": "number" },
        "likesCount": { "type": "number" },
        "published": { "type": "boolean" },
        "seoTitle": { "type": "string", "maxLength": 150 },
        "seoDescription": { "type": "string", "maxLength": 300 },
        "seoKeywords": { "type": "string", "maxLength": 300 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["title", "slug", "content", "category", "authorId", "published"]
    },
    "Comment": {
      "title": "Comment",
      "description": "Reader comment or reply on a blog post",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "postId": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 100 },
        "authorEmail": { "type": "string", "maxLength": 150 },
        "authorAvatar": { "type": "string", "maxLength": 1000 },
        "content": { "type": "string", "maxLength": 2000 },
        "parentId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["approved", "pending", "rejected"] },
        "createdAt": { "type": "string" }
      },
      "required": ["postId", "authorName", "content", "status", "createdAt"]
    },
    "ContactMessage": {
      "title": "ContactMessage",
      "description": "Contact form submissions from readers",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 150 },
        "subject": { "type": "string", "maxLength": 200 },
        "message": { "type": "string", "maxLength": 3000 },
        "createdAt": { "type": "string" },
        "read": { "type": "boolean" }
      },
      "required": ["name", "email", "subject", "message", "createdAt"]
    },
    "Subscriber": {
      "title": "Subscriber",
      "description": "Newsletter email subscriber",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 150 },
        "subscribedAt": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "unsubscribed"] }
      },
      "required": ["email", "subscribedAt", "status"]
    },
    "GalleryItem": {
      "title": "GalleryItem",
      "description": "Photo or moment showcase item",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 150 },
        "description": { "type": "string", "maxLength": 500 },
        "imageUrl": { "type": "string", "maxLength": 1000 },
        "category": { "type": "string", "maxLength": 60 },
        "createdAt": { "type": "string" }
      },
      "required": ["title", "imageUrl", "category", "createdAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile document",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 150 },
        "displayName": { "type": "string", "maxLength": 100 },
        "photoURL": { "type": "string", "maxLength": 1000 },
        "role": { "type": "string", "enum": ["admin", "reader"] },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email", "role"]
    }
  },
  "firestore": {
    "/posts/{postId}": {
      "schema": "Post",
      "description": "Blog posts and articles"
    },
    "/posts/{postId}/comments/{commentId}": {
      "schema": "Comment",
      "description": "Comments attached to a specific post"
    },
    "/contact_messages/{messageId}": {
      "schema": "ContactMessage",
      "description": "Reader contact messages"
    },
    "/subscribers/{subscriberId}": {
      "schema": "Subscriber",
      "description": "Newsletter subscribers"
    },
    "/gallery/{itemId}": {
      "schema": "GalleryItem",
      "description": "Gallery items and photos"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User identity and role records"
    }
  }
}
